generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ======================================================
// USER / ADMIN
// ======================================================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String   @default("USER")
  isActive  Boolean  @default(true)

  news      News[]
  likes     NewsLike[]
  comments  Comment[]
  media     Media[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
}


// ======================================================
// CATEGORY
// ======================================================

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)

  news      News[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}


// ======================================================
// NEWS
// ======================================================

model News {
  id          Int      @id @default(autoincrement())

  title       String
  slug        String   @unique
  excerpt     String?  @db.Text
  content     String   @db.LongText
  image       String?

  status      String   @default("DRAFT")
  views       Int      @default(0)

  authorId    Int
  categoryId  Int

  author      User     @relation(fields: [authorId], references: [id])
  category    Category @relation(fields: [categoryId], references: [id])

  likes       NewsLike[]
  comments    Comment[]

  featuredNews FeaturedNews?

  publishedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([createdAt])
}


// ======================================================
// NEWS LIKE
// ======================================================

model NewsLike {
  id        Int      @id @default(autoincrement())

  newsId    Int
  userId    Int

  news      News     @relation(fields: [newsId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@unique([newsId, userId])
  @@index([newsId])
  @@index([userId])
}


// ======================================================
// COMMENT
// ======================================================

model Comment {
  id        Int      @id @default(autoincrement())

  content   String   @db.Text

  newsId    Int
  userId    Int

  status    String   @default("PENDING")

  news      News     @relation(fields: [newsId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([newsId])
  @@index([userId])
  @@index([status])
}


// ======================================================
// FEATURED NEWS / SLIDE UTAMA
// ======================================================

model FeaturedNews {
  id        Int      @id @default(autoincrement())

  newsId    Int      @unique
  position  Int      @default(1)

  isActive  Boolean  @default(true)

  news      News     @relation(fields: [newsId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
  @@index([isActive])
}


// ======================================================
// BREAKING NEWS
// ======================================================

model BreakingNews {
  id        Int      @id @default(autoincrement())

  title     String
  slug      String?  @unique

  status    String   @default("ACTIVE")

  startedAt DateTime @default(now())
  endedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([startedAt])
  @@index([endedAt])
}


// ======================================================
// AGENDA
// ======================================================

model Agenda {
  id          Int      @id @default(autoincrement())

  title       String
  slug        String   @unique

  description String?  @db.Text

  image       String?

  location    String?

  eventDate   DateTime

  status      String   @default("UPCOMING")

  link        String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventDate])
  @@index([status])
}


// ======================================================
// MEDIA
// ======================================================

model Media {
  id          Int      @id @default(autoincrement())

  fileName    String
  fileUrl     String

  mimeType    String?
  fileSize    Int?

  alt         String?
  caption     String?

  type        String   @default("IMAGE")

  uploadedById Int

  uploadedBy  User     @relation(fields: [uploadedById], references: [id])

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([uploadedById])
  @@index([type])
}


// ======================================================
// BANNER
// ======================================================

model Banner {
  id          Int      @id @default(autoincrement())

  title       String?

  image       String

  link        String?

  position    String   @default("HOME")

  status      String   @default("ACTIVE")

  startAt     DateTime?
  endAt       DateTime?

  sortOrder   Int      @default(1)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([position])
  @@index([status])
  @@index([sortOrder])
  @@index([startAt])
  @@index([endAt])
}


// ======================================================
// SETTINGS
// ======================================================

model Setting {
  id        Int      @id @default(autoincrement())

  key       String   @unique
  value     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}